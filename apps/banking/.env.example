# Documents the variables and their local values. Nothing reads a .env file yet: the app has
# no defaults (it fails fast), docker-compose.yml and tests/conftest.py set these values.
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and the connection hangs.
BANKING_DB_URL=postgresql+psycopg://banking:banking@127.0.0.1:5432/banking
# Tests only: the running web app the e2e tests target.
BANKING_E2E_URL=http://127.0.0.1:8000
